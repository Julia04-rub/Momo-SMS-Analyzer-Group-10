{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Transaction Category Schema",
  "type": "object",
  "description": "JSON schema for transaction category entity",
  "properties": {
    "category_id": {
      "type": "integer",
      "description": "Unique category identifier",
      "minimum": 1
    },
    "category_name": {
      "type": "string",
      "description": "Category display name",
      "minLength": 1,
      "maxLength": 50
    },
    "category_code": {
      "type": "string",
      "description": "Short code identifier",
      "minLength": 2,
      "maxLength": 10,
      "pattern": "^[A-Z_]+$"
    },
    "description": {
      "type": ["string", "null"],
      "description": "Detailed category description"
    },
    "is_active": {
      "type": "boolean",
      "description": "Category active status",
      "default": true
    },
    "transaction_count": {
      "type": "integer",
      "description": "Number of transactions in this category (when included)",
      "minimum": 0
    },
    "total_amount": {
      "type": "number",
      "description": "Total amount for this category (when included)",
      "minimum": 0
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Category creation timestamp"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last update timestamp"
    }
  },
  "required": ["category_id", "category_name", "category_code", "is_active"],
  "additionalProperties": false
}
