{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Transaction Schema",
  "type": "object",
  "description": "JSON schema for mobile money transaction entity",
  "properties": {
    "transaction_id": {
      "type": "integer",
      "description": "Unique transaction identifier",
      "minimum": 1
    },
    "financial_transaction_id": {
      "type": ["string", "null"],
      "description": "External transaction ID from SMS",
      "maxLength": 20
    },
    "sender": {
      "type": ["object", "null"],
      "description": "Sender information",
      "properties": {
        "user_id": {
          "type": "integer",
          "minimum": 1
        },
        "full_name": {
          "type": "string",
          "maxLength": 100
        },
        "phone_number": {
          "type": "string",
          "maxLength": 15
        }
      }
    },
    "receiver": {
      "type": ["object", "null"],
      "description": "Receiver information",
      "properties": {
        "user_id": {
          "type": "integer",
          "minimum": 1
        },
        "full_name": {
          "type": "string",
          "maxLength": 100
        },
        "phone_number": {
          "type": "string",
          "maxLength": 15
        }
      }
    },
    "category": {
      "type": "object",
      "description": "Transaction category information",
      "properties": {
        "category_id": {
          "type": "integer",
          "minimum": 1
        },
        "category_name": {
          "type": "string",
          "maxLength": 50
        },
        "category_code": {
          "type": "string",
          "maxLength": 10
        }
      },
      "required": ["category_id", "category_name", "category_code"]
    },
    "amount": {
      "type": "number",
      "description": "Transaction amount",
      "minimum": 0,
      "multipleOf": 0.01
    },
    "currency": {
      "type": "string",
      "description": "Currency code",
      "default": "RWF",
      "maxLength": 3
    },
    "fee": {
      "type": "number",
      "description": "Transaction fee",
      "minimum": 0,
      "multipleOf": 0.01
    },
    "new_balance": {
      "type": ["number", "null"],
      "description": "Account balance after transaction",
      "minimum": 0,
      "multipleOf": 0.01
    },
    "transaction_datetime": {
      "type": "string",
      "format": "date-time",
      "description": "Transaction execution timestamp"
    },
    "status": {
      "type": "string",
      "enum": ["completed", "pending", "failed"],
      "description": "Transaction status"
    },
    "message_content": {
      "type": ["string", "null"],
      "description": "Original SMS message content"
    },
    "sender_message": {
      "type": ["string", "null"],
      "description": "Message from sender"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Record creation timestamp"
    }
  },
  "required": [
    "transaction_id", 
    "category", 
    "amount", 
    "currency", 
    "fee", 
    "transaction_datetime", 
    "status"
  ],
  "additionalProperties": false
}
